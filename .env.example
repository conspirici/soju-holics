# Resend API key (https://resend.com/api-keys). Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender for contact-form notifications. Must be on a domain verified in Resend,
# e.g. "Sojuholics Website <website@soju-holics.com>".
# For local testing before the domain is verified you can use "onboarding@resend.dev",
# which only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# Inbox that receives contact-form messages. Defaults to info@soju-holics.com.
CONTACT_TO_EMAIL=info@soju-holics.com

# Canonical site URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.soju-holics.com
